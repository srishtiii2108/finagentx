# ==========================================
# FINAGENTX - Git Ignore
# ==========================================

# ------------------------------------------
# Node.js / React
# ------------------------------------------

node_modules/
client/node_modules/
server/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
client/dist/
server/dist/


# ------------------------------------------
# Environment Variables / Secrets
# ------------------------------------------

.env
.env.*
!.env.example

client/.env
client/.env.*
server/.env
server/.env.*

backend_ai/.env
backend_ai/.env.*


# ------------------------------------------
# Python
# ------------------------------------------

# Virtual environments
venv/
.venv/
env/
ENV/

backend_ai/venv/
backend_ai/.venv/

# Python cache
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python build/package files
*.egg
*.egg-info/
dist/
build/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/


# ------------------------------------------
# IDE / Editor
# ------------------------------------------

.vscode/
.idea/
*.swp
*.swo

# VS Code local settings
.history/


# ------------------------------------------
# OS Generated Files
# ------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini


# ------------------------------------------
# Logs
# ------------------------------------------

*.log
logs/


# ------------------------------------------
# Temporary Files
# ------------------------------------------

*.tmp
*.temp
*.bak


# ------------------------------------------
# Jupyter Notebook
# ------------------------------------------

.ipynb_checkpoints/


# ------------------------------------------
# Local Database / Runtime Files
# ------------------------------------------

*.sqlite
*.sqlite3
*.db


# ------------------------------------------
# Secrets / Certificates
# ------------------------------------------

*.pem
*.key
*.crt


# ------------------------------------------
# Cache
# ------------------------------------------

.cache/
.parcel-cache/
.vite/